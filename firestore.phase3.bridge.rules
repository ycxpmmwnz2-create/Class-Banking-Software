rules_version = '2';

// PHASE 3 BRIDGE RULES — CANDIDATE DEPLOYMENT ARTIFACT, NOT CURRENT RULES.
//
// This artifact is installed only after the existing teacher/classroom
// foundation has been created and reconciled and before any scoped credential
// is copied. It deliberately keeps the legacy classroom usable during the
// maintenance window while exposing only read-only scoped data needed to
// verify the migration. The checked-in firestore.rules remains unchanged.

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isLegacyTeacher() {
      return isSignedIn()
        && request.auth.uid == "YkYUzIzy0aW7roolM1VaLcIJPuN2";
    }

    function teacherDoc(uid) {
      return get(/databases/$(database)/documents/teachers/$(uid));
    }

    function classroomDoc(classroomId) {
      return get(/databases/$(database)/documents/classrooms/$(classroomId));
    }

    // At most two distinct document lookups are required: the caller's
    // teacher record and the requested classroom root. Repeated reads of the
    // same path are cached by the rules engine.
    function isActiveTeacher(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && teacherDoc(uid).data.uid == uid
        && teacherDoc(uid).data.status == "active";
    }

    function isActiveOwner(classroomId) {
      return isActiveTeacher(request.auth.uid)
        && teacherDoc(request.auth.uid).data.classroomId == classroomId
        && classroomDoc(classroomId).data.ownerUid == request.auth.uid;
    }

    function isStudentOf(classroomId, studentId) {
      return isSignedIn()
        && request.auth.token.role == "student"
        && request.auth.token.classroomId == classroomId
        && request.auth.token.studentId == studentId;
    }

    // Ownership records are server-managed. The bridge permits an active
    // teacher to read only their own record for migration verification.
    match /teachers/{teacherUid} {
      allow get: if isActiveTeacher(teacherUid);
      allow list, create, update, delete: if false;
    }

    // No recursive classrooms/** allow is present. Each safe scoped surface is
    // enumerated explicitly; scoped credentials are explicitly denied below.
    match /classrooms/{classroomId} {
      allow get: if isActiveOwner(classroomId);
      allow list, create, update, delete: if false;

      match /students/{studentId} {
        allow get: if isActiveOwner(classroomId)
          || isStudentOf(classroomId, studentId);
        allow list: if isActiveOwner(classroomId);
        allow create, update, delete: if false;
      }

      match /transactions/{transactionId} {
        allow get, list: if isActiveOwner(classroomId);
        allow create, update, delete: if false;
      }

      match /loginHistory/{entryId} {
        allow get, list: if isActiveOwner(classroomId);
        allow create, update, delete: if false;
      }

      match /studentCredentials/{loginId} {
        allow read, write: if false;
      }
    }

    // Scoped authentication logs are read-only and tenant-bound.
    match /studentAuthLogs/{classroomId}/logs/{logId} {
      allow get, list: if isActiveOwner(classroomId);
      allow create, update, delete: if false;
    }

    // The original teacher retains the exact flat-log read needed by the
    // legacy maintenance UI. No client can mutate a flat log.
    match /studentAuthLogs/{logId} {
      allow get, list: if isLegacyTeacher();
      allow create, update, delete: if false;
    }

    // Flat and scoped credentials are server-only, including for their owner.
    match /studentCredentials/{loginId} {
      allow read, write: if false;
    }

    match /teacherInvitations/{inviteId} {
      allow read, write: if false;
    }

    match /classroomLoginCodes/{codeId} {
      allow read, write: if false;
    }

    match /studentLoginThrottle/{throttleId} {
      allow read, write: if false;
    }

    match /studentAuthUnresolvedLogs/{logId} {
      allow read, write: if false;
    }

    // Preserve the default-off legacy client during maintenance. This access
    // is intentionally not broadened to every active teacher.
    match /morganBank/{document=**} {
      allow read, write: if isLegacyTeacher();
    }
  }
}
