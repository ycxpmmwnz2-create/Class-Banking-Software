# Emulator-only Functions parameter values for the Phase 2B Item 8 gate-OFF
# acceptance project. The Firebase CLI resolves declared parameters from
# dotenv files in the functions source directory only
# (firebase-tools 15.20.0 `lib/functions/env.js:149-162`,
# `lib/deploy/functions/params.js:163-193`); a shell variable is not consulted
# and the CLI would otherwise prompt interactively. Both values below are
# non-secret emulator configuration; the release ID is ignored by the emulator
# branch of the runtime guard but must be declared for non-interactive discovery.
#
# This file is loaded only when the CLI is invoked with
# --project demo-morgan-bank-phase2b-server-off-test, which is a Firebase demo
# project. It can never apply to the production `morgan-bank` project.
MULTI_TEACHER_V2_ENABLED=false
MULTI_TEACHER_V2_RELEASE_ID=multi-account-invitations-functions-v1
